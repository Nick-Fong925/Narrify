# Backend-specific paths (root .gitignore covers all generic rules)
# These relative paths are needed so git applies them correctly from this subdirectory.

# Sensitive credentials
config/youtube_credentials.json
config/youtube_token.json
config/client_secret*.json
.env

# Generated media directories
app/video/media/generated_videos/*
!app/video/media/generated_videos/.gitkeep
app/video/media/base_videos/*.mp4
!app/video/media/base_videos/.gitkeep
app/video/training/*
!app/video/training/.gitkeep

# Pending uploads queue
app/video/media/pending_uploads/*

# Logs
logs/*
!logs/.gitkeep
