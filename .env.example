# Reddit API (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=your_reddit_user_agent

# Anthropic (optional - for LLM story cleaning)
ANTHROPIC_API_KEY=your_anthropic_api_key

# YouTube OAuth (place files in backend/config/)
# YOUTUBE_CLIENT_SECRETS_FILE=config/youtube_credentials.json
# YOUTUBE_TOKEN_FILE=config/youtube_token.json

# Ntfy push notifications (https://ntfy.sh)
NTFY_TOPIC=your_ntfy_topic
